# Copy to .env and replace every value (e.g. `openssl rand -hex 24`). Never commit .env.
# Superuser of the postgres container (used only by seed/load.sh).
POSTGRES_PASSWORD=change-me-postgres
# Login role of the web app (DML on the application tables).
AUTOCARE_APP_PASSWORD=change-me-app
# Read-only login for the SQLBuddy Appliance (SELECT only).
SQLBUDDY_RO_PASSWORD=change-me-readonly
# Password given to every seeded web login (customers and admins) by seed/generate.py.
SEED_DEMO_PASSWORD=change-me-demo
