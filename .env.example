# Copy to .env and replace every value (e.g. `openssl rand -hex 24`). Never commit .env.
# Superuser of the postgres container (used only by seed/load.sh).
POSTGRES_PASSWORD=change-me-postgres
# Login role of the web app (DML on the application tables).
AUTOCARE_APP_PASSWORD=change-me-app
# Read-only login for the SQLBuddy Appliance (SELECT only).
SQLBUDDY_RO_PASSWORD=change-me-readonly
# Password of the six demo web logins (seed/generate.py); all other seeded logins cannot sign in.
SEED_DEMO_PASSWORD=change-me-demo
# Web app (compose service "app").
# Secret that signs the session tokens (JWT, HS256): at least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Public origin of the site; state-changing requests must carry exactly this Origin.
# Cookies get the Secure flag when it starts with https://.
APP_ORIGIN=http://localhost:3000
# Express "trust proxy" (false | true | number of hops | loopback); set when a proxy/tunnel sits in front.
TRUST_PROXY=false
